# Database — production/previews use Netlify Database (Neon Postgres under
# the hood), auto-provisioned via the @netlify/database package + a deploy.
# Netlify injects NETLIFY_DB_URL at build/runtime — src/lib/db.ts and
# drizzle.config.ts both fall back to it when DATABASE_URL isn't set, so
# nothing needs configuring in the Netlify UI for this.
# For local dev: `npm run db:up` starts a Postgres container matching this URL.
# The container publishes on host port DB_PORT (default 5440, not 5432, to avoid
# clashing with other local Postgres instances). If you set DB_PORT, change the
# port in DATABASE_URL to match.
DATABASE_URL=postgres://postgres:postgres@localhost:5440/lawforaisafety

# LinkedIn OAuth (applicant + admin flows share one app)
# https://developer.linkedin.com — Product: "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google OAuth (applicant flow only)
# https://console.cloud.google.com — OAuth 2.0 client, type "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin session
# Random 32+ byte secret, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Comma-separated whitelist of admin emails (must match verified LinkedIn OAuth email)
ADMIN_EMAILS=
# Comma-separated LinkedIn account ids (OIDC `sub`) of those same admins. Optional but
# recommended: once set, admin login needs an allowlisted email AND an allowlisted sub,
# so a LinkedIn account re-registered against an admin's address gets nowhere. To
# collect the values, leave this empty, have each admin log in once, and copy the
# ids from /admin/settings → Admin logins.
ADMIN_LINKEDIN_SUBS=
# Comma-separated subset of ADMIN_EMAILS who can also erase data, switch signup on/off,
# and read the audit log and admin logins. Everyone else in ADMIN_EMAILS can only review
# applications. Empty = those pages are closed to everyone (never open to all).
# Keep at least two people here so an erasure request can't get stuck on one person.
TECH_ADMIN_EMAILS=

# Shared secret between the hourly scheduled function (netlify/functions/sweep-expired-data.mts)
# and the route it calls (/api/cron/sweep). Random 32+ bytes, e.g. `openssl rand -base64 32`.
# Unset = the route refuses every request, so expired data is only cleared by the
# per-submission backstop sweeps.
CRON_SECRET=

# Application PII hashing (for processed_applications.email_hash reapplication lookup)
# Random 32+ byte secret, e.g. `openssl rand -base64 32` — must NOT equal SESSION_SECRET
EMAIL_HASH_SECRET=

# Brevo (transactional email — approval/rejection notices, newsletter
# confirm/courtesy email; same key also used for the mailout Contacts API)
# https://app.brevo.com — SMTP & API → API Keys
BREVO_API_KEY=
# Sender address — must be a verified sender/domain in Brevo before sending works
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Law for AI Safety
# Numeric list ID to subscribe confirmed newsletter signups to —
# https://app.brevo.com → Contacts → Lists (create one, use its ID)
BREVO_LIST_ID=

# Slack. Only SLACK_WORKSPACE_URL is required (e.g. https://yourworkspace.slack.com — not a
# secret): approving an application needs it to build the "Invite to Slack" link.
# The other two come from a Slack app (free plan is fine) and are optional:
#   SLACK_WEBHOOK_URL — incoming webhook; without it reviewers get no "new application" message
#   SLACK_BOT_TOKEN   — bot token with users:read + users:read.email; without it the approved
#                       screen always shows the invite step instead of "already a member"
SLACK_WORKSPACE_URL=
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Cloudflare Turnstile (bot protection on newsletter + apply forms)
# https://dash.cloudflare.com — Turnstile — add a widget for this domain
# For local dev, use Cloudflare's always-pass test keys instead of real ones:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Base URL of the deployed site (used to build OAuth callback / redirect URLs)
# `npm run dev` runs on port 3001 (see package.json) — must match whatever's
# registered as the redirect URI in the LinkedIn/Google app configs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
