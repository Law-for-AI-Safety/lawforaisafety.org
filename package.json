{
  "name": "lawforaisafety.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db-ensure.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/optimize-images.mjs",
    "images": "node scripts/optimize-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lighthouse": "bash scripts/lighthouse.sh dev",
    "lighthouse:build": "bash scripts/lighthouse.sh build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:down": "docker compose --env-file .env.local down",
    "db:reset": "docker compose --env-file .env.local down -v && docker compose --env-file .env.local up -d db"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.6",
    "next": "16.2.11",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
