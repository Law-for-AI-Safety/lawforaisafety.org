{
  "name": "lawforaisafety.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:ensure",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/optimize-images.mjs",
    "images": "node scripts/optimize-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:no-db": "vitest run --project node --project dom",
    "e2e": "vitest run --config vitest.e2e.config.mts",
    "e2e:browser": "playwright install --with-deps chromium",
    "test:coverage": "node scripts/test-coverage.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "check-all": "node scripts/check-all.mjs",
    "content:check": "node --import tsx scripts/content.ts check",
    "content:format": "node --import tsx scripts/content.ts format",
    "cms:guard": "node scripts/cms-guard.mjs",
    "indexnow:dry-run": "node scripts/indexnow.mjs --dry-run",
    "lighthouse": "bash scripts/lighthouse.sh dev",
    "lighthouse:build": "bash scripts/lighthouse.sh build",
    "db:generate": "drizzle-kit generate",
    "db:ensure": "node scripts/db-ensure.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/db-seed.mjs",
    "dev:accounts": "node --import tsx scripts/dev-accounts.ts",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:down": "docker compose --env-file .env.local down",
    "db:reset": "docker compose --env-file .env.local down -v && docker compose --env-file .env.local up -d db",
    "predemo": "npm install --prefix demo --no-audit --no-fund",
    "demo": "tsx demo/index.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11",
    "@netlify/database": "^1.1.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.6",
    "next": "16.3.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.2",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
